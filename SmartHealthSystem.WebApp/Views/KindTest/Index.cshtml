@using SmartHealthSystem.Application.DTOs.User
@model List<GetAllUsersDto>

@{
    ViewData["Title"] = "Böbrek Sağlığı Analizi";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">

<style>
    /* SIDEBAR KAYMASINI ENGELLEYEN AYAR */
    .analysis-container {
        background: #f0f4f8;
        padding: 2rem;
        min-height: 100vh;
        /* Sidebar'ın altına girmemesi için sol boşluk (Sidebar genişliğine göre ayarla) */
        margin-left: 20px;
    }

    /* Eğer sidebar sabitse (fixed), aşağıdaki satırı aktif et:
        body { padding-left: 250px; }
        */

    .card-custom {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        background: white;
    }

    .section-title {
        color: #2980b9;
        font-weight: 700;
        border-bottom: 2px solid #d6eaf8;
        padding-bottom: 10px;
        margin-bottom: 20px;
        text-transform: uppercase;
        font-size: 0.9rem;
        letter-spacing: 1px;
    }

    .form-label {
        font-weight: 600;
        color: #444;
        font-size: 0.9rem;
    }

    .btn-analyze {
        background: #2980b9;
        color: white;
        padding: 15px;
        font-weight: 700;
        border-radius: 12px;
        transition: 0.3s;
        width: 100%;
        border: none;
        margin-top: 20px;
    }

        .btn-analyze:hover {
            background: #1a5276;
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(41,128,185,0.3);
        }

    #resultPanel {
        display: none;
        margin-top: 30px;
        border-radius: 15px;
        overflow: hidden;
    }
</style>

<div class="analysis-container">
    <div class="container-fluid">
        <div class="card card-custom p-4 p-lg-5">
            <h2 class="text-center mb-4"><i class="fas fa-microscope text-primary"></i> Böbrek Fonksiyon Analizi</h2>

            <form id="kidneyAnalysisForm">
                <div class="section-title"><i class="fas fa-user-circle"></i> 1. Hasta Seçimi</div>
                <div class="mb-4">
                    <select class="form-select form-select-lg" name="PatientId" required>
                        <option value="">-- Analiz Edilecek Hastayı Seçiniz --</option>
                        @foreach (var user in Model)
                        {
                            <option value="@user.Id">@user.FirstName @user.LastName (@user.Email)</option>
                        }
                    </select>
                </div>

                <div class="section-title"><i class="fas fa-flask"></i> 2. İdrar ve Kan Laboratuvar Verileri</div>
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label class="form-label">Yaş</label>
                        <input type="number" name="Age" class="form-control" required placeholder="Örn: 55">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Kan Basıncı (BP)</label>
                        <input type="number" name="Bp" class="form-control" required placeholder="Örn: 80">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Özgül Ağırlık (SG)</label>
                        <input type="number" step="0.001" name="Sg" class="form-control" required placeholder="1.020">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Albümin (AL)</label>
                        <select name="Al" class="form-select" required>
                            @for (int i = 0; i <= 5; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label class="form-label">Şeker (SU)</label>
                        <select name="Su" class="form-select" required>
                            @for (int i = 0; i <= 5; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Kan Şekeri (BGR)</label>
                        <input type="number" name="Bgr" class="form-control" required placeholder="120">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Kan Üresi (BU)</label>
                        <input type="number" name="Bu" class="form-control" required placeholder="40">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Serum Kreatinin (SC)</label>
                        <input type="number" step="0.1" name="Sc" class="form-control" required placeholder="1.2">
                    </div>
                </div>

                <div class="section-title"><i class="fas fa-vial"></i> 3. Elektrolit ve Hemoglobin Değerleri</div>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label">Sodyum (SOD)</label>
                        <input type="number" name="Sod" class="form-control" required placeholder="135">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Potasyum (POT)</label>
                        <input type="number" step="0.1" name="Pot" class="form-control" required placeholder="4.5">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Hemoglobin (HEMO)</label>
                        <input type="number" step="0.1" name="Hemo" class="form-control" required placeholder="14.5">
                    </div>
                </div>

                <input type="hidden" name="Rbc" value="0">
                <input type="hidden" name="Pc" value="0">
                <input type="hidden" name="Pcc" value="0">
                <input type="hidden" name="Ba" value="0">

                <button type="submit" class="btn btn-analyze">
                    <i class="fas fa-stethoscope me-2"></i> BÖBREK ANALİZİNİ GERÇEKLEŞTİR
                </button>
            </form>

            <div id="resultPanel" class="card shadow-sm p-4">
                <div class="row text-center align-items-center">
                    <div class="col-md-4 border-end">
                        <h6 class="text-muted fw-bold">CKD RİSK ORANI</h6>
                        <h1 id="resRisk" class="display-4 fw-bold text-primary">%0.0</h1>
                        <span id="resBadge" class="badge p-2 px-3">Hesaplanıyor</span>
                    </div>
                    <div class="col-md-4 border-end">
                        <h6 class="text-muted fw-bold">BÖBREK SAĞLIK SKORU</h6>
                        <h1 id="resScore" class="display-4 fw-bold">0</h1>
                        <div class="progress mt-2" style="height: 10px; border-radius: 5px;">
                            <div id="resProgress" class="progress-bar" role="progressbar"></div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <h6 class="text-muted fw-bold">NEFROLOJİ NOTU</h6>
                        <p id="resAdvice" class="small mt-2 text-dark fw-medium"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.getElementById('kidneyAnalysisForm').addEventListener('submit', async function (e) {
        e.preventDefault();

        const formData = new FormData(this);
        const finalRequest = {};

        formData.forEach((value, key) => {
            if (["Sg", "Sc", "Pot", "Hemo"].includes(key)) {
                finalRequest[key] = parseFloat(value.toString().replace(',', '.'));
            } else if (key === "PatientId") {
                finalRequest[key] = value;
            } else {
                finalRequest[key] = parseInt(value);
            }
        });

        Swal.fire({
            title: 'Analiz Ediliyor...',
            allowOutsideClick: false,
            didOpen: () => { Swal.showLoading(); }
        });

        try {
            const response = await fetch('/KindTest/CreateAnalysis', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(finalRequest)
            });

            const result = await response.json();

            if (response.ok && result.isSuccess) {
                const risk = result.riskPercentage || 0;
                const score = result.healthScore || 0;
                const advice = result.recommendations || "Öneri bulunamadı.";

                document.getElementById('resRisk').innerText = '%' + risk.toFixed(1);
                document.getElementById('resScore').innerText = score;
                document.getElementById('resAdvice').innerText = advice;
                document.getElementById('resProgress').style.width = score + "%";

                const panel = document.getElementById('resultPanel');
                const badge = document.getElementById('resBadge');

                panel.style.display = 'block';

                if (risk > 60) {
                    badge.className = "badge bg-danger p-2 px-3";
                    badge.innerText = "YÜKSEK RİSK";
                } else if (risk > 20) {
                    badge.className = "badge bg-warning text-dark p-2 px-3";
                    badge.innerText = "ORTA RİSK";
                } else {
                    badge.className = "badge bg-success p-2 px-3";
                    badge.innerText = "DÜŞÜK RİSK";
                }

                panel.scrollIntoView({ behavior: 'smooth' });
                Swal.close();
            } else {
                Swal.fire('Hata', result.message || 'Hata oluştu.', 'error');
            }
        } catch (error) {
            Swal.fire('Hata', 'Bağlantı kesildi.', 'error');
        }
    });
</script>