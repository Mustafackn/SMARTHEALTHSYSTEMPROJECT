<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Health</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --sidebar-bg: #ffffff;
            --main-bg: #f8f9fa;
            --primary-purple: #6f42c1;
            --sidebar-width: 280px;
        }

        body { font-family: 'Inter', sans-serif; background-color: var(--main-bg); margin: 0; overflow-x: hidden; }

        #wrapper { display: flex; width: 100%; }
        
        #sidebar {
            width: var(--sidebar-width); min-width: var(--sidebar-width);
            background: var(--sidebar-bg); height: 100vh;
            border-right: 1px solid #eee; position: fixed; z-index: 100;
        }
        .sidebar-brand { padding: 30px; font-size: 1.4rem; font-weight: 800; color: var(--primary-purple); display: flex; align-items: center; }
        .nav-label { padding: 15px 30px 5px; font-size: 11px; font-weight: 700; color: #adb5bd; text-transform: uppercase; }
        .nav-link { 
            display: flex; align-items: center; padding: 12px 25px; color: #555; 
            text-decoration: none; margin: 4px 15px; border-radius: 12px; transition: 0.3s; font-weight: 500;
        }
        .nav-link i { margin-right: 12px; font-size: 1.1rem; width: 20px; text-align: center; }
        .nav-link:hover, .nav-link.active { 
            background: linear-gradient(90deg, #8e2de2, #4a00e0); color: white !important; 
            box-shadow: 0 4px 12px rgba(111, 66, 193, 0.2);
        }

        #content-wrapper { margin-left: var(--sidebar-width); width: 100%; min-height: 100vh; display: flex; flex-direction: column; }
        
        .topbar {
            height: 70px; background: #fff; display: flex; align-items: center;
            justify-content: space-between; padding: 0 30px; border-bottom: 1px solid #eee;
        }
        .search-area { background: #f1f3f7; padding: 8px 20px; border-radius: 50px; display: flex; align-items: center; }
        .search-area input { border: none; background: transparent; outline: none; margin-left: 10px; width: 200px; }
        
        .user-profile img { width: 35px; height: 35px; border-radius: 50%; border: 2px solid var(--primary-purple); }
    </style>
</head>
<body>

    <div id="wrapper">
        <aside id="sidebar">
            <div class="sidebar-brand">
                <i class="fas fa-heartbeat me-2"></i> SMART HEALTH
            </div>
            
            <div class="nav-label">Dashboard</div>
            <a asp-controller="Home" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                <i class="bi bi-grid-fill"></i> Ana Sayfa
            </a>
            
            <div class="nav-label">İçerik Yönetimi</div>
            <a asp-controller="Banner" asp-action="Create" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Banner" ? "active" : "")">
                <i class="bi bi-image-fill"></i> Slider Yönetimi
            </a>
            
            <div class="nav-label">Analizler</div>
            <a asp-controller="Cardiovascular" asp-action="Create" 
   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Cardiovascular" ? "active" : "")">
    <i class="fas fa-heart-pulse"></i> 
    <span>Kardiyovasküler Analiz</span>
</a>
           <a asp-controller="Diabetes" asp-action="Create" 
   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Diabetes" ? "active" : "")">
    <i class="fas fa-droplet"></i> 
    <span>Diyabet Analizi</span>
</a>
            <a asp-controller="CancerTest" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "CancerTest" ? "active" : "")">
                <i class="fas fa-dna"></i> Kanser Analizi
            </a>
            
            <div class="nav-label">Yönetim</div>
            <a asp-controller="Patient" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Patient" ? "active" : "")">
                <i class="fas fa-procedures"></i> Hastalarım
            </a>
            <a href="#" class="nav-link"><i class="fas fa-envelope"></i> Mesajlar <span class="badge bg-danger ms-auto">5</span></a>
        </aside>

        <div id="content-wrapper">
            <header class="topbar">
                <div class="search-area">
                    <i class="bi bi-search text-muted"></i>
                    <input type="text" placeholder="Sistemde ara...">
                </div>
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-bell fs-5 text-muted"></i>
                    <div class="user-profile d-flex align-items-center gap-2">
                        <span class="fw-bold small d-none d-md-block">Admin User</span>
                        <img src="https://ui-avatars.com/api/?name=Admin+User&background=6f42c1&color=fff" alt="Profil">
                    </div>
                </div>
            </header>

            <main class="p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    @* KRİTİK DÜZELTME: Bu satır sayfalardan gelen scriptlerin çalışmasını sağlar *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>