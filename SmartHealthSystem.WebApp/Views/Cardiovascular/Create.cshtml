@model SmartHealthSystem.Application.Features.CardiovascularTestData.Commands.CreateCardiovascularTestData.CreateCardiovascularTestDataCommandRequest

@{
    ViewData["Title"] = "AI Kalp Sağlığı Analizi";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            
            @* Başlık *@
            <div class="text-center mb-5">
                <div class="icon-box mb-3">
                    <i class="bi bi-shield-pulse text-primary" style="font-size: 3.5rem;"></i>
                </div>
                <h2 class="fw-bold text-dark">Kardiyovasküler Risk Analizi</h2>
                <p class="text-muted">Lütfen tüm sağlık verilerini eksiksiz giriniz. Analiz sonuçları seçilen kullanıcıya kaydedilecektir.</p>
            </div>

            <div class="card border-0 shadow-lg" style="border-radius: 25px;">
                <div class="card-body p-4 p-md-5">
                    
                    <form asp-action="Create" method="post" id="cardioForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                        @* 0. BÖLÜM: KULLANICI SEÇİMİ *@
                        <div class="form-section mb-5 p-4 bg-light rounded-4 border-start border-primary border-4">
                            <div class="d-flex align-items-center mb-3">
                                <i class="bi bi-person-check-fill text-primary me-2 fs-4"></i>
                                <h5 class="mb-0 fw-bold">Analiz Edilecek Hasta/Kullanıcı</h5>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <select asp-for="UserId" class="form-select form-select-lg custom-input shadow-sm" required>
                                        <option value="">-- Listeden Kullanıcı Seçiniz --</option>
                                        @if (ViewBag.UserList != null)
                                        {
                                            foreach (var user in (List<SmartHealthSystem.Application.DTOs.User.GetAllUsersDto>)ViewBag.UserList)
                                            {
                                                <option value="@user.Id">@user.FirstName @user.LastName (@user.UserName)</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="UserId" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        @* 1. BÖLÜM: FİZİKSEL VERİLER (Age, Gender, Height, Weight) *@
                        <div class="form-section mb-5">
                            <h6 class="text-uppercase text-primary fw-bold mb-4 border-bottom pb-2">01. Fiziksel Parametreler</h6>
                            <div class="row g-4">
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">Yaş</label>
                                    <input asp-for="Age" type="number" class="form-control form-control-lg custom-input" placeholder="Örn: 45" />
                                    <span asp-validation-for="Age" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">Cinsiyet</label>
                                    <select asp-for="Gender" class="form-select form-select-lg custom-input">
                                        <option value="1">Erkek</option>
                                        <option value="2">Kadın</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">Boy (cm)</label>
                                    <input asp-for="Height" type="number" class="form-control form-control-lg custom-input" placeholder="175" />
                                    <span asp-validation-for="Height" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">Kilo (kg)</label>
                                    <input asp-for="Weight" type="number" step="0.1" class="form-control form-control-lg custom-input" placeholder="70.5" />
                                    <span asp-validation-for="Weight" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        @* 2. BÖLÜM: KLİNİK ÖLÇÜMLER (Systolic, Diastolic, Cholesterol, Glucose) *@
                        <div class="form-section mb-5">
                            <h6 class="text-uppercase text-danger fw-bold mb-4 border-bottom pb-2">02. Klinik Ölçümler</h6>
                            <div class="row g-4">
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">Büyük Tansiyon (Systolic)</label>
                                    <input asp-for="SystolicBP" type="number" class="form-control form-control-lg custom-input" placeholder="ap_hi" />
                                    <span asp-validation-for="SystolicBP" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">Küçük Tansiyon (Diastolic)</label>
                                    <input asp-for="DiastolicBP" type="number" class="form-control form-control-lg custom-input" placeholder="ap_lo" />
                                    <span asp-validation-for="DiastolicBP" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">Kolesterol</label>
                                    <select asp-for="Cholesterol" class="form-select form-select-lg custom-input">
                                        <option value="1">Normal</option>
                                        <option value="2">Yüksek</option>
                                        <option value="3">Çok Yüksek</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">Glikoz (Şeker)</label>
                                    <select asp-for="Glucose" class="form-select form-select-lg custom-input">
                                        <option value="1">Normal</option>
                                        <option value="2">Yüksek</option>
                                        <option value="3">Çok Yüksek</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        @* 3. BÖLÜM: YAŞAM TARZI (Smoke, Alco, Active) *@
                        <div class="form-section mb-5">
                            <h6 class="text-uppercase text-success fw-bold mb-4 border-bottom pb-2">03. Yaşam Tarzı ve Alışkanlıklar</h6>
                            <div class="row g-4">
                                <div class="col-md-4">
                                    <div class="option-card p-3 rounded-4 border text-center">
                                        <i class="bi bi-lungs text-info d-block mb-2 fs-3"></i>
                                        <label class="fw-bold small d-block mb-2">Sigara Kullanımı</label>
                                        <select asp-for="Smoke" class="form-select border-0 text-center fw-bold bg-light">
                                            <option value="0">İçmiyor</option>
                                            <option value="1">İçiyor</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="option-card p-3 rounded-4 border text-center">
                                        <i class="bi bi-cup-straw text-warning d-block mb-2 fs-3"></i>
                                        <label class="fw-bold small d-block mb-2">Alkol Tüketimi</label>
                                        <select asp-for="Alco" class="form-select border-0 text-center fw-bold bg-light">
                                            <option value="0">Kullanmıyor</option>
                                            <option value="1">Kullanıyor</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="option-card p-3 rounded-4 border border-primary bg-primary-subtle text-center">
                                        <i class="bi bi-bicycle text-primary d-block mb-2 fs-3"></i>
                                        <label class="fw-bold small d-block mb-2">Fiziksel Aktivite</label>
                                        <select asp-for="Active" class="form-select border-0 text-center fw-bold bg-transparent">
                                            <option value="1">Düzenli Egzersiz</option>
                                            <option value="0">Hareketsiz Yaşam</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* SUBMIT BUTTON *@
                        <div class="text-center">
                            <button type="submit" class="btn btn-primary btn-lg px-5 py-3 shadow-lg fw-bold w-100" 
                                    style="border-radius: 15px; background: linear-gradient(135deg, #0d6efd, #6610f2); border:none;">
                                <i class="bi bi-lightning-charge-fill me-2"></i> ANALİZİ YAP VE KAYDET
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@* CSS *@
<style>
    body { background-color: #f8fafc; }
    .custom-input { border: 2px solid #e2e8f0; border-radius: 12px; transition: all 0.3s; }
    .custom-input:focus { border-color: #0d6efd; box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.1); }
    .option-card { transition: all 0.3s ease; }
    .option-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.05); }
</style>

@* MODAL *@
<div class="modal fade" id="aiLoadingModal" data-bs-backdrop="static" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered text-center">
        <div class="modal-content bg-transparent border-0 shadow-none">
            <div class="spinner-border text-light" style="width: 4rem; height: 4rem;" role="status"></div>
            <h4 class="text-white mt-4 fw-bold">Yapay Zeka Analiz Ediyor...</h4>
            <p class="text-white-50">Lütfen bekleyiniz, bu işlem birkaç saniye sürebilir.</p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            $('#cardioForm').on('submit', function() {
                if ($(this).valid()) {
                    var myModal = new bootstrap.Modal(document.getElementById('aiLoadingModal'));
                    myModal.show();
                }
            });
        });
    </script>
}