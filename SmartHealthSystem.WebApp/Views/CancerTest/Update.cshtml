@model SmartHealthSystem.Application.DTOs.CancerTestData.UpdateCancerTestDataDto

@{
    ViewData["Title"] = "Gelişmiş Meme Kanseri Analizi";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    :root {
        --primary-color: #4361ee;
        --secondary-color: #3f37c9;
        --success-color: #4cc9f0;
        --bg-color: #f8f9fd;
        --card-shadow: 0 20px 27px 0 rgba(0, 0, 0, 0.05);
    }

    body {
        font-family: 'Inter', sans-serif;
        background-color: var(--bg-color);
        color: #2d3436;
    }

    /* Modern Kart Tasarımı */
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 20px;
        box-shadow: var(--card-shadow);
        backdrop-filter: blur(10px);
        margin-top: 2rem;
    }

    .header-gradient {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
        padding: 2.5rem;
        border-radius: 20px 20px 0 0;
        color: white;
        position: relative;
        overflow: hidden;
    }

        .header-gradient::after {
            content: '\f471'; /* FontAwesome microscope */
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            position: absolute;
            right: 20px;
            bottom: -10px;
            font-size: 8rem;
            opacity: 0.1;
        }

    /* Input Grupları */
    .parameter-box {
        background: #ffffff;
        border: 1px solid #edf2f7;
        padding: 15px;
        border-radius: 12px;
        transition: all 0.3s ease;
        margin-bottom: 1rem;
    }

        .parameter-box:hover {
            border-color: var(--primary-color);
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.08);
            transform: translateY(-2px);
        }

    .form-label {
        font-weight: 600;
        color: #4a5568;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .form-label i {
            color: var(--primary-color);
            width: 16px;
        }

    .form-control {
        border: none;
        border-bottom: 2px solid #e2e8f0;
        border-radius: 0;
        padding: 8px 0;
        font-weight: 500;
        font-size: 1.1rem;
        color: #2d3748;
        background: transparent;
    }

        .form-control:focus {
            box-shadow: none;
            border-color: var(--primary-color);
            background: transparent;
        }

    /* Butonlar */
    .btn-action-container {
        background: #fcfcfd;
        padding: 2rem;
        border-radius: 0 0 20px 20px;
        border-top: 1px solid #edf2f7;
    }

    .btn-update {
        background: var(--primary-color);
        color: white;
        border: none;
        padding: 1rem 2rem;
        border-radius: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        transition: all 0.4s;
        box-shadow: 0 10px 20px rgba(67, 97, 238, 0.2);
    }

        .btn-update:hover {
            background: var(--secondary-color);
            color: white;
            transform: scale(1.02);
            box-shadow: 0 15px 25px rgba(67, 97, 238, 0.3);
        }

    .btn-cancel {
        color: #718096;
        font-weight: 600;
        text-decoration: none;
        padding: 1rem;
        transition: 0.3s;
    }

        .btn-cancel:hover {
            color: #e53e3e;
        }
</style>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-xl-11">
            <div class="glass-card">
                <div class="header-gradient">
                    <div class="d-flex align-items-center">
                        <div class="bg-white p-3 rounded-circle mr-4 text-primary shadow-sm">
                            <i class="fas fa-dna fa-2x"></i>
                        </div>
                        <div>
                            <h2 class="font-weight-bold mb-1">Analiz Laboratuvarı</h2>
                            <p class="mb-0 opacity-75">Kitleye ait teknik ölçüm verilerini buradan güncelleyebilirsiniz.</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-lg-5">
                    <form id="updateCancerForm">
                        <input type="hidden" id="dataId" value="@Model.Id" />

                        <div class="row">
                            <div class="col-12 mb-4">
                                <h5 class="text-uppercase tracking-wider font-weight-bold text-muted small mb-3">
                                    <i class="fas fa-layer-group mr-2"></i>Mekanik Ölçümler (Mean Values)
                                </h5>
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="parameter-box">
                                            <label class="form-label"><i class="fas fa-circle-notch"></i> Yarıçap (Radius)</label>
                                            <input type="number" step="0.00001" class="form-control" id="radiusMean" value="@Model.RadiusMean.ToString().Replace(",", ".")">
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="parameter-box">
                                            <label class="form-label"><i class="fas fa-braille"></i> Doku (Texture)</label>
                                            <input type="number" step="0.00001" class="form-control" id="textureMean" value="@Model.TextureMean.ToString().Replace(",", ".")">
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="parameter-box">
                                            <label class="form-label"><i class="fas fa-draw-polygon"></i> Çevre (Perimeter)</label>
                                            <input type="number" step="0.00001" class="form-control" id="perimeterMean" value="@Model.PerimeterMean.ToString().Replace(",", ".")">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <h5 class="text-uppercase tracking-wider font-weight-bold text-muted small mb-3">
                                    <i class="fas fa-atom mr-2"></i>Morfolojik Detaylar
                                </h5>
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="parameter-box">
                                            <label class="form-label"><i class="fas fa-vector-square"></i> Alan (Area)</label>
                                            <input type="number" step="0.00001" class="form-control" id="areaMean" value="@Model.AreaMean.ToString().Replace(",", ".")">
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="parameter-box">
                                            <label class="form-label"><i class="fas fa-wave-square"></i> Pürüzsüzlük</label>
                                            <input type="number" step="0.00001" class="form-control" id="smoothnessMean" value="@Model.SmoothnessMean.ToString().Replace(",", ".")">
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="parameter-box">
                                            <label class="form-label"><i class="fas fa-compress-arrows-alt"></i> Sıkılık</label>
                                            <input type="number" step="0.00001" class="form-control" id="compactnessMean" value="@Model.CompactnessMean.ToString().Replace(",", ".")">
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="parameter-box">
                                            <label class="form-label"><i class="fas fa-adjust"></i> İçbükeylik</label>
                                            <input type="number" step="0.00001" class="form-control" id="concavityMean" value="@Model.ConcavityMean.ToString().Replace(",", ".")">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 mt-3">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="parameter-box">
                                            <label class="form-label"><i class="fas fa-dot-circle"></i> Kritik Noktalar</label>
                                            <input type="number" step="0.00001" class="form-control" id="concavePointsMean" value="@Model.ConcavePointsMean.ToString().Replace(",", ".")">
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="parameter-box">
                                            <label class="form-label"><i class="fas fa-balance-scale"></i> Simetri</label>
                                            <input type="number" step="0.00001" class="form-control" id="symmetryMean" value="@Model.SymmetryMean.ToString().Replace(",", ".")">
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="parameter-box">
                                            <label class="form-label"><i class="fas fa-project-diagram"></i> Fraktal Boyut</label>
                                            <input type="number" step="0.00001" class="form-control" id="fractalDimensionMean" value="@Model.FractalDimensionMean.ToString().Replace(",", ".")">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="btn-action-container">
                    <div class="d-flex justify-content-between align-items-center">
                        <a href="javascript:history.back()" class="btn-cancel">
                            <i class="fas fa-chevron-left mr-2"></i>Değişiklikleri İptal Et
                        </a>
                        <button type="button" onclick="updateAnalysis()" class="btn btn-update px-5">
                            <i class="fas fa-robot mr-2"></i>Yapay Zekayı Yeniden Çalıştır
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    async function updateAnalysis() {
        // Form verilerini topluyoruz (Eski script ile aynı mantık, görselleştirme değişti)
        const updateDto = {
            Id: parseInt(document.getElementById('dataId').value),
            RadiusMean: parseFloat(document.getElementById('radiusMean').value),
            TextureMean: parseFloat(document.getElementById('textureMean').value),
            PerimeterMean: parseFloat(document.getElementById('perimeterMean').value),
            AreaMean: parseFloat(document.getElementById('areaMean').value),
            SmoothnessMean: parseFloat(document.getElementById('smoothnessMean').value),
            CompactnessMean: parseFloat(document.getElementById('compactnessMean').value),
            ConcavityMean: parseFloat(document.getElementById('concavityMean').value),
            ConcavePointsMean: parseFloat(document.getElementById('concavePointsMean').value),
            SymmetryMean: parseFloat(document.getElementById('symmetryMean').value),
            FractalDimensionMean: parseFloat(document.getElementById('fractalDimensionMean').value)
        };

        const requestBody = { UpdateCancerTestDataDto: updateDto };

        Swal.fire({
            title: 'Analiz Başlatıldı',
            html: 'Yapay zeka katmanları yükleniyor...<br><b>Bulut sunucusuna bağlanılıyor.</b>',
            timerProgressBar: true,
            didOpen: () => { Swal.showLoading(); }
        });

        try {
            const response = await fetch('/CancerTest/Update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(requestBody)
            });

            const result = await response.json();

            if (response.ok) {
                Swal.fire({
                    icon: 'success',
                    title: 'Analiz Tamamlandı',
                    html: `Veriler başarıyla güncellendi.<br><h4 class="mt-3">Yeni Risk Skoru: <b>%${result.newRiskPercentage}</b></h4>`,
                    confirmButtonColor: '#4361ee'
                }).then(() => {
                    window.location.href = document.referrer;
                });
            } else {
                Swal.fire('Hata!', result.message, 'error');
            }
        } catch (error) {
            Swal.fire('Hata!', 'Yapay zeka servisine erişilemedi.', 'error');
        }
    }
</script>