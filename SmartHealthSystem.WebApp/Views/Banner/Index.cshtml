@model IEnumerable<SmartHealthSystem.Application.DTOs.BannerDto.GetBannerDto>

@{
    ViewData["Title"] = "Slider Yönetimi";
}

<div class="container mt-2">
    @* Üst Alan: Başlık ve Ekle Butonu *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-0">Slider Yönetimi</h4>
            <small class="text-muted">Ana sayfadaki reklam ve duyuruları buradan yönetebilirsiniz.</small>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 shadow-sm" style="border-radius: 10px; background: linear-gradient(90deg, #8e2de2, #4a00e0); border:none;">
            <i class="bi bi-plus-lg me-1"></i> Yeni Banner Ekle
        </a>
    </div>

    @* Tablo Kartı *@
    <div class="card border-0 shadow-sm" style="border-radius: 15px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 text-muted fw-semibold" style="width: 100px;">Görsel</th>
                            <th class="py-3 text-muted fw-semibold">Banner Bilgisi</th>
                            <th class="py-3 text-muted fw-semibold text-center">Sıra</th>
                            <th class="py-3 text-muted fw-semibold text-center">Durum</th>
                            <th class="pe-4 py-3 text-muted fw-semibold text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        @* Resim Önizleme *@
                                        <div class="rounded-3 overflow-hidden shadow-sm" style="width: 80px; height: 50px;">
                                            <img src="@item.ImageUrl" class="w-100 h-100 object-fit-cover"
                                                 onerror="this.src='/img/no-image.png';" alt="banner" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.Title</div>
                                        <div class="small text-muted text-truncate" style="max-width: 250px;">@item.Description</div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border shadow-sm px-3">@item.Order</span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill">Pasif</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="btn-group shadow-sm" style="border-radius: 8px; overflow: hidden;">
                                            @* DÜZELTME: asp-action="Edit" olan yer "Update" yapıldı *@
                                            <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-white btn-sm border-end" title="Düzenle">
                                                <i class="bi bi-pencil-square text-primary"></i>
                                            </a>
                                            <button type="button" class="btn btn-white btn-sm" title="Sil"
                                                    onclick="confirmDelete('@item.Id')">
                                                <i class="bi bi-trash3 text-danger"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-image-fill display-4 d-block mb-3 opacity-25"></i>
                                    Henüz bir banner eklenmemiş.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id) {
            if(confirm("Bu banner'ı silmek istediğinizden emin misiniz?")) {
                // Silme aksiyonunuzun adının 'Delete' olduğunu varsayıyoruz
                window.location.href = '@Url.Action("Delete", "Banner")/' + id;
            }
        }
    </script>
}